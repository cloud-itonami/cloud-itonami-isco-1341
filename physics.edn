;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a facility-walkthrough robot performs
;; safety-checklist inspection and supply-restocking tasks for child care
;; services managers (ISCO 1341). Its physical work is restocking supplies
;; onto high shelves out of children's reach, and one checklist item is
;; whether the radiator guards in the playrooms stay cool enough to touch.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-1341"
 :cases
 [{:id :supply-box-high-shelf
   :kind :manipulator
   :procedure "arm lifts a supply box (nappies, wipes, craft materials) from the delivery cart onto a shelf at 1.6 m, out of children's reach"
   :params {:l1-m 0.75 :l2-m 0.65 :m1-kg 7.0 :m2-kg 5.0
            :from [0.60 0.20] :to [0.45 1.25] :duration-s 3.0 :steps 450}
   :sweep {:param :payload-kg :values [2.0 4.0 6.0 9.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: continuous shoulder torque of a ~10 kg-payload, 1.4 m-reach collaborative arm"}
   :boundary {:lo 0.5 :hi 40.0}}
  {:id :radiator-guard-touch-temp
   :kind :thermal
   :procedure "checklist item: 12 mm MDF radiator guard in a playroom, heated from behind by the air off the radiator (radiator air temperature swept) for a four-hour session; the child-side face must stay touchable"
   :params {:conductivity-w-mk 0.12 :density-kg-m3 700.0 :specific-heat-j-kgk 1700.0
            :thickness-m 0.012 :t0-c 21.0 :h-front-w-m2k 10.0 :t-back-ambient-c 21.0 :h-back-w-m2k 8.0
            :threshold-c 43.0 :duration-s 14400.0 :nodes 21}
   :sweep {:param :t-hot-c :values [50.0 60.0 70.0 80.0 90.0]}
   :quantity :final-back-c
   :limit {:max 43.0 :basis "estimate: ~43 C maximum accessible surface temperature commonly used as low-surface-temperature guidance where young children or vulnerable people can touch heat emitters"}
   :boundary {:lo 40.0 :hi 95.0}}]}
